# ─── App ────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ChirplyMint
CRON_SECRET=

# ─── Supabase ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Meta / Instagram ──────────────────────
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_WEBHOOK_SECRET=                  # App Secret for webhook signature verification (Settings → Basic)

# ─── AI Providers (Multi-Provider Fallback) ───
# Primary recommended (free, ultra-fast ~300 tok/s):
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# NVIDIA NIM (active models: nvidia/llama-3.1-nemotron-70b-instruct, mistralai/mistral-large-2-instruct)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Secondary Fallbacks:
GEMINI_API_KEY=
OPENAI_API_KEY=

# ─── Email: Resend ──────────────────────────
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
DEFAULT_FROM_EMAIL=

# ─── Payments: Cashfree ─────────────────────
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2025-01-01
NEXT_PUBLIC_CASHFREE_ENV=sandbox
CASHFREE_WEBHOOK_SECRET=

# ─── Rate Limiting: Upstash ─────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Analytics: PostHog ─────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com