# ─── App ────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ChirplyMint
CRON_SECRET=

# ─── Supabase ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Meta / Instagram ──────────────────────
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_WEBHOOK_SECRET=                  # App Secret for webhook signature verification (Settings → Basic)

# ─── AI: NVIDIA NIM (primary) ───────────────
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=

# ─── AI: Groq (fallback — used if NVIDIA fails) ──
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ─── Email: Resend ──────────────────────────
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
DEFAULT_FROM_EMAIL=

# ─── Payments: Cashfree ─────────────────────
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2025-01-01
NEXT_PUBLIC_CASHFREE_ENV=sandbox
CASHFREE_WEBHOOK_SECRET=

# ─── Rate Limiting: Upstash ─────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Error Tracking: Sentry (optional but recommended) ──
SENTRY_DSN=

# ─── Logging ────────────────────────────────
LOG_LEVEL=info                       # debug | info | warn | error (prod default: info)

# ─── Feature Flags ──────────────────────────
HUMAN_AGENT_APPROVED=false           # set true after Meta approves the "Human Agent" permission

# ─── Analytics: PostHog ─────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com